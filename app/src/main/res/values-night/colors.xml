<resources>
    <!--
        Waxd terminal/ops-console theme. Same four hex values as every other
        waxd reskin, mapped onto this app's existing colorPrimary/colorOnPrimary/
        colorSurface/colorSurfaceContainer roles (see styles.xml). green/orange/red
        are left untouched: they're the pass/warning/fail attestation status
        indicators, a security signal, not brand chrome.
    -->
    <color name="green">#591B5E20</color> <!-- Green 900 -->
    <color name="orange">#80F57F17</color> <!-- Yellow 900 (not orange; better color difference to dark red) -->
    <color name="red">#80B71C1C</color> <!-- Red 900 -->

    <color name="graphenePrimaryColor">#2E9E5B</color>
    <color name="grapheneOnPrimaryColor">#0A0C0A</color>
    <color name="grapheneSurfaceColor">#0A0C0A</color>
    <color name="grapheneSurfaceContainerColor">#16201A</color>
</resources>
